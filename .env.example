# Values for `docker compose up`. Copy to `.env` in the project root.

# Required: at least 32 random characters.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Required: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional overrides
# OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/relay-support
# CLIENT_ORIGIN=http://localhost:3000
# COOKIE_SECURE=false
