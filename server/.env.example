# Server environment. Copy to `.env` and fill in the values.
NODE_ENV=development
PORT=5000

# Local MongoDB, or a MongoDB Atlas connection string (mongodb+srv://...)
MONGO_URI=mongodb://127.0.0.1:27017/relay-support

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=7d

# Origin(s) of the web app, comma separated (used for CORS and the OpenRouter referer header)
CLIENT_ORIGIN=http://localhost:3000

# Set to true when the site is served over HTTPS. Defaults to true when NODE_ENV=production.
# COOKIE_SECURE=false

# https://openrouter.ai/keys. Never expose this key to the browser.
OPENROUTER_API_KEY=
# Any OpenRouter model id. Models ending in :free cost nothing but are rate limited.
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# Override only to use an OpenRouter-compatible proxy.
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
